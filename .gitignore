# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.spec.bak

# virtual environments
.venv/
venv/
env/

# packaging output
release/
*.AppImage
*.AppDir/
installer_output/

# downloaded engines (never commit 100 MB binaries)
engines/*.exe
engines/stockfish*
engines/lc0*
!engines/README.md

# the web build is generated by tools/build_web.py
web/python/
web/icons/
web/data/puzzles.json
web/data/sets.json

# node, used only by tools/web_smoke.mjs
node_modules/

# generated previews
preview/*.gif

# user data that must not be shared
data/settings.json
data/*.db-wal
data/*.db-shm

# editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
